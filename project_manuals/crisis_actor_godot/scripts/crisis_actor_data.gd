			"C": "【Cエンド：祟りの顕現（公式暴露）】\n30年前の土砂崩れの生存者リスト（黒カード）をメディアにリーク。開発強行の事実が明るみに出て、県と開発企業の信頼は崩壊する。"
		}
	}
}

static func get_phase_info(phase_number: int) -> Dictionary:
	for phase in PHASES:
		if phase["phase"] == phase_number:
			return phase
	return {}

static func get_blackout_info(code: String) -> Dictionary:
	for blackout in BLACKOUT_CODES:
		if blackout["code"] == code:
			return blackout
	return {}

static func get_forbidden_replacement(word: String) -> Dictionary:
	for item in FORBIDDEN_WORDS:
		if item["forbidden"] == word:
			return item
	return {}


